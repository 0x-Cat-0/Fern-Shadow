{
  "expo": {
    "name": "蕨影",
    "slug": "zhang-ying",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icons/图标.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "image": "./src/assets/icons/图标.png"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zhangying.app",
      "infoPlist": {
        "CFBundleDisplayName": "蕨影",
        "CFBundleName": "FernShadow"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/图标.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.zhangying.app",
      "versionCode": 1
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_APP_START",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "蕨影需要访问您的相册来选择植物照片。",
          "cameraPermission": "蕨影需要访问您的相机来拍摄植物照片。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "蕨影需要访问您的相机来拍摄植物照片。"
        }
      ],
      [
        "expo-sqlite"
      ]
    ]
  }
}