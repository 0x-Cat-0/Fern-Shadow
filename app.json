{
  "expo": {
    "name": "蕨影",
    "slug": "fern-shadow",
    "version": "1.3.13",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icons/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "image": "./assets/icons/icon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fernshadow.app",
      "infoPlist": {
        "CFBundleDisplayName": "蕨影",
        "CFBundleName": "FernShadow"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fernshadow.app",
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "runtimeVersion": "1.3.0",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "蕨影需要访问您的相册来选择植物照片。",
          "cameraPermission": "蕨影需要访问您的相机来拍摄植物照片。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "蕨影需要访问您的相机来拍摄植物照片。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "蕨影需要访问您的相册来选择植物照片。",
          "savePhotosPermission": "蕨影需要保存照片到您的相册。"
        }
      ],
      [
        "expo-sqlite"
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eb66772e-65e1-4ff2-bff8-1324d1f8ab28"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/eb66772e-65e1-4ff2-bff8-1324d1f8ab28"
    },
    "owner": "0xcat"
  }
}
